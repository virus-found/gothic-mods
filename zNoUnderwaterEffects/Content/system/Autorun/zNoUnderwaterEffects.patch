#engine [G1, G1A, G2, G2A]
	#patch [zNoUnderwaterEffects]
		// disable camera underwater color blend and sound muffling
		INT func_zCAICamera_CheckUnderWaterFX = ZenDef(0x004B4240, 0x004C3060, 0x004BAD70, 0x004BD2E0)
		INT func_zCSkyControler_Outdoor_SetUnderwaterFX = ZenDef(0x005BAA30, 0x005D8590, 0x005D9230, 0x005DFFE0)

		#assembler [func_zCAICamera_CheckUnderWaterFX]
			xor eax, eax
			ret
		#/assembler

		#assembler [func_zCSkyControler_Outdoor_SetUnderwaterFX]
			ret 4
		#/assembler
	#/patch
#/engine
